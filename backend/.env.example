DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# --- Week 5 AI assistant (server only, never put these in frontend/.env) ---
# Get a free key at https://aistudio.google.com/apikey and paste it into backend/.env only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=8000
# Provider-failure test: set AI_PROVIDER=off, or GEMINI_BASE_URL=http://127.0.0.1:9 (unreachable), then restart.
