[Unit]
Description=ShopSmart Express API
After=network-online.target postgresql.service
# Wants, not Requires: with Requires, stopping or restarting PostgreSQL also stopped the API and it
# stayed down (found in the hosted outage test). Now the API keeps running, /api/health reports 503
# while the database is down, and requests work again as soon as PostgreSQL is back.
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=shopsmart
WorkingDirectory=/opt/shopsmart/app/backend
# Server-only settings (DATABASE_URL, provider key). Readable by root and the shopsmart user only.
EnvironmentFile=/etc/shopsmart/api.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
